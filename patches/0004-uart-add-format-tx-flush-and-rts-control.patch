diff --git a/sdk/platform/include/interfaces/uart.h b/sdk/platform/include/interfaces/uart.h
--- a/sdk/platform/include/interfaces/uart.h
+++ b/sdk/platform/include/interfaces/uart.h
@@ -11,11 +11,26 @@
 #define _UART_H
 
 #include <stdint.h>	/* For typed integers */
+#include <stdbool.h>	/* For bool */
 
 void uart_init(void);
 int uart_getc(void);
 void uart_putc(unsigned char c);
 void uart_putc_raw(uint8_t c);
+
+typedef enum { UART_PARITY_NONE, UART_PARITY_ODD, UART_PARITY_EVEN } uart_parity_t;
+
+/* Set 8 data bits + parity + 1 or 2 stop bits (uart_init() gives 8N1).
+ * Call it right after uart_init(), while the line is idle. */
+void uart_set_format(uart_parity_t parity, unsigned stop_bits);
+
+/* Wait until the last bit of the last byte has left the shift register
+ * (LSR.TEMT), not just the holding register. RS-485 drivers must stay
+ * enabled until then. */
+void uart_tx_flush(void);
+
+/* Drive the RTS output (MCR.RTS). Many RS-485 adapters use it as DE/RE. */
+void uart_set_rts(bool asserted);
 void uart_enable_irq(void);
 void uart_disable_irq(void);
 
diff --git a/sdk/platform/src/uart.c b/sdk/platform/src/uart.c
--- a/sdk/platform/src/uart.c
+++ b/sdk/platform/src/uart.c
@@ -264,6 +264,38 @@
 	uart_write(UART_THR_OFFSET, c);
 }
 
+void
+uart_set_format(uart_parity_t parity, unsigned stop_bits)
+{
+	/* LCR: bits 1:0 = 11 (8 data bits), bit 2 = 2 stop bits,
+	 * bit 3 = parity enable, bit 4 = even parity, DLAB (bit 7) = 0 */
+	uint8_t lcr = 0x3;
+
+	if (stop_bits == 2)
+		lcr |= 0x04;
+	if (parity == UART_PARITY_ODD)
+		lcr |= 0x08;
+	else if (parity == UART_PARITY_EVEN)
+		lcr |= 0x18;
+
+	uart_write(UART_LCR_OFFSET, lcr);
+}
+
+void
+uart_tx_flush(void)
+{
+	/* TEMT is set when both the holding register/FIFO and the
+	 * shift register are empty */
+	while (!(uart_read(UART_LSR_OFFSET) & UART_LSR_TEMT));
+}
+
+void
+uart_set_rts(bool asserted)
+{
+	/* MCR bit 1 = RTS (uart_init() leaves MCR at 0) */
+	uart_write(UART_MCR_OFFSET, asserted ? 0x2 : 0x0);
+}
+
 #ifndef PLAT_NO_IRQ
 void
 uart_enable_irq(void)
