+++ b/sdk/platform/src/uart.c
@@ -253,6 +253,17 @@ uart_putc(uint8_t c)
 	return;
 }
 
+/* Like uart_putc() but sends the byte as is, without turning '\n' into
+ * "\r\n". For binary protocols. */
+void
+uart_putc_raw(uint8_t c)
+{
+	/* Wait for transmit register to be flushed */
+	while (!(uart_read(UART_LSR_OFFSET) & UART_LSR_THRE));
+
+	uart_write(UART_THR_OFFSET, c);
+}
+
